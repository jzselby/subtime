# Optional. The app runs fully offline with none of these set — they only
# turn on the "Coaches dashboard" feature (Team settings → Coaches
# dashboard). See supabase/schema.sql for what to run in a Supabase project
# first, and dashboard/.env.example for the other half of this.

# Project URL and anon (public) key, from your Supabase project's API settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the dashboard/ site is deployed. The app appends ?t=<shareToken> to
# this to build the link a coach copies/shares — include the trailing slash.
VITE_DASHBOARD_URL=
