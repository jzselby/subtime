# Committed on purpose, unlike .env.local: this is Supabase's publishable
# (anon) key, not the secret/service_role key. It's meant to ship in client
# bundles — RLS is default-deny on every table, and both RPC functions
# (supabase/schema.sql) require a per-team token/key the anon key alone
# doesn't grant. Committing it lets CI build a working dashboard with no
# extra secrets wiring.
VITE_SUPABASE_URL=https://jhcbjbbcuuyzkwoxxmbe.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_ytchuf82XUBbZMhhmV6ABw_FxcaguZJ
